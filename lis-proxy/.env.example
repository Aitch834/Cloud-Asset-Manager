# Copy this to .env and fill in values on the UK VPS

PORT=3001

# Shared secret — must match LIS_PROXY_SECRET on the Replit API server
PROXY_SECRET=change-me-to-a-long-random-string

# From Replit Secrets panel (copy the value)
LIS_SUBSCRIPTION_KEY=

# From Replit Secrets panel (copy the value)
LIS_B2C_CLIENT_ID=

# Set to true while testing with sandbox test credentials, remove for production
LIS_USE_SANDBOX_API=true
