modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck-mobile"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck-dashboard"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck-admin-portal"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck-website"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck-api"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "dup-batch-ref"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "no-silent-saves-dashboard"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "no-silent-saves-admin-portal"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "no-silent-saves-website"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "no-silent-saves-test-dashboard"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "no-silent-saves-mobile"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "no-hardcoded-prices-website"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "no-annual-pricing-claim-drift-website"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "no-hardcoded-prices-admin-portal"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "no-hardcoded-prices-dashboard"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "cache-guard-api"

[[workflows.workflow]]
name = "typecheck-mobile"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mobile run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck-dashboard"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/dashboard run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck-admin-portal"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/admin-portal run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck-website"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/website run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck-api"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "dup-batch-ref"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node artifacts/api-server/scripts/check-duplicate-batch-ref.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "no-silent-saves-dashboard"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node artifacts/dashboard/scripts/fix-mutation-ok.mjs artifacts/dashboard/src --dry"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "no-silent-saves-admin-portal"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node artifacts/dashboard/scripts/fix-mutation-ok.mjs artifacts/admin-portal/src --dry"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "no-silent-saves-website"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node artifacts/dashboard/scripts/fix-mutation-ok.mjs artifacts/website/src --dry"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "no-silent-saves-test-dashboard"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node artifacts/dashboard/scripts/fix-mutation-ok.mjs artifacts/test-dashboard/src --dry"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "no-silent-saves-mobile"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node artifacts/dashboard/scripts/fix-mutation-ok.mjs artifacts/mobile --dry"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "no-hardcoded-prices-website"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node artifacts/website/scripts/check-hardcoded-prices.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "no-annual-pricing-claim-drift-website"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node artifacts/website/scripts/check-annual-pricing-ceiling.mjs"

[[workflows.workflow]]
name = "no-hardcoded-prices-admin-portal"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node artifacts/admin-portal/scripts/check-hardcoded-prices.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "no-hardcoded-prices-dashboard"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node artifacts/dashboard/scripts/check-hardcoded-prices.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "cache-guard-api"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:cache-guard"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 900000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
LIS_USE_SANDBOX_API = "true"
LIS_LIP_REDIRECT_URL = "https://api.bdefarmtrac.co.uk/api/lis/callback"
LIS_LIP_API_BASE = "https://api.service.livestockinformation.org.uk"
LIS_LIP_API_URL_SANDBOX = "https://sandbox.movement.api.livestockinformation.org.uk/lis-public-sdbx/v1.0"
LIS_LIP_B2C_AUTHORITY_SANDBOX = "https://livestockinformationb2cprod.b2clogin.com/tfp/livestockinformationb2cprod.onmicrosoft.com/B2C_1A_THIRDPARTY_SIGNIN/v2.0"
LIS_LIP_SCOPE_SANDBOX = "https://livestockinformationb2cprod.onmicrosoft.com/ms-apimlisapisdbx/user_impersonation"
LIS_LIP_REDIRECT_URI = ""

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 5173

[[ports]]
localPort = 18115
externalPort = 3002

[[ports]]
localPort = 18652
externalPort = 6000

[[ports]]
localPort = 18653
externalPort = 5000

[[ports]]
localPort = 19161
externalPort = 3001

[[ports]]
localPort = 19162
externalPort = 3003

[[ports]]
localPort = 23183
externalPort = 80

[[ports]]
localPort = 25580
externalPort = 3000

[[ports]]
localPort = 25581
externalPort = 4200

[objectStorage]
defaultBucketID = "replit-objstore-4376c68c-358c-4bbe-9eb0-37e779037a5a"
