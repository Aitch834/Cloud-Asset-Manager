{
  "name": "@workspace/dashboard",
  "version": "1.4.17",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node -e \"const fs=require('fs');if(!fs.existsSync('dist/public/index.html')){const{execSync}=require('child_process');execSync('pnpm run build',{stdio:'inherit'})}\" && node serve.mjs",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "node scripts/check-no-live-page-print.mjs && node scripts/check-restricted-inputs-columns.mjs && NODE_OPTIONS=--max-old-space-size=4096 tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts --exclude '**/e2e/**'",
    "test:e2e:install-browser": "playwright install chromium",
    "test:e2e:smoke-browser": "playwright test --config playwright.smoke.config.ts",
    "pretest:e2e": "pnpm run test:e2e:smoke-browser",
    "test:e2e": "playwright test",
    "test:e2e:excise-rate-review": "playwright test e2e/excise-duty-rate-review-date.spec.ts",
    "test:e2e:vine-register-parcel-ref": "playwright test e2e/vine-register-parcel-ref-popover.spec.ts",
    "test:e2e:print-pagination": "playwright test e2e/viticulture-print-pagination.spec.ts",
    "test:e2e:analytics-print": "playwright test e2e/analytics-chart-print-pagination.spec.ts",
    "test:e2e:financial-enterprise-toggle": "playwright test e2e/financial-enterprise-row-toggle.spec.ts"
  },
